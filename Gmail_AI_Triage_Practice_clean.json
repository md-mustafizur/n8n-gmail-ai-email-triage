      "name": "Get many labels",
      "webhookId": "f49d185b-8b9a-46ad-afa7-7faa524e61d0",
      "executeOnce": true,
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const labels = $input.all().map(i => i.json);\nconst items = $('Code in JavaScript').all();\nconst findId = (name) => labels.find(l => l.name === name)?.id;\n\nreturn items.map(item => {\n  const d = item.json;\n  let labelName = 'AI-' + String(d.category || '').replace(/\\s+/g, '');\n  let labelId = findId(labelName);\n  if (!labelId) {\n    labelName = 'AI-NeedsReview';\n    labelId = findId(labelName);\n  }\n  return { json: { ...d, label_name: labelName, label_id: labelId || '' } };\n});"
      },
