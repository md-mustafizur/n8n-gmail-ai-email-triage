          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.text;\nconst clean = raw.replace(/```json|```/g, '').trim();\nlet data;\ntry {\n  data = JSON.parse(clean);\n} catch (e) {\n  data = { category: 'NeedsReview', priority: 'low', summary: 'AI response invalid', suggested_reply: '', needs_human: true };\n}\nconst src = $('Edit Fields').item.json;\ndata.id = src.id;\ndata.threadId = src.threadId;\ndata.subject = src.subject;\ndata.from_email = src.from_email || '';\nreturn { json: data };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        96
