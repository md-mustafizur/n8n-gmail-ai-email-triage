    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an email triage assistant. Classify the email into exactly one category: Urgent, Important, Client, Billing, Routine, Informational, Low Value.\nReturn only valid JSON with these keys: category, priority (high, medium or low), summary, suggested_reply, needs_human (true or false). No extra text.\nRules for suggested_reply: write a complete reply that needs no editing. Never use placeholders or brackets such as [Name] or [Sender Name]. Start with \"Hello,\" and end with \"Best regards\". If no reply is needed, return an empty string.\nCategory rules: invoices, payment reminders and overdue payments are Billing. Use Urgent only for outages, security problems, or deadlines within 24 hours.\nEmail subject: {{ $json.subject }}\nEmail body: {{ $json.text }}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -288,
        96
      ],
      "id": "139b7f79-f531-4c59-933d-f4b931fe5788",
