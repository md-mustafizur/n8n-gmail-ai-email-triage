    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst report = {};\n\nfor (const d of items) {\n  const cat = d.category || 'NeedsReview';\n  if (!report[cat]) {\n    report[cat] = { category: cat, count: 0, high_priority: 0, needs_human: 0, subjects: [], summaries: [] };\n  }\n  report[cat].count++;\n  if (d.priority === 'high') report[cat].high_priority++;\n  if (d.needs_human) report[cat].needs_human++;\n  report[cat].subjects.push(d.subject);\n  report[cat].summaries.push(d.summary);\n}\n\nreturn Object.values(report).map(r => ({\n  json: { ...r, subjects: r.subjects.join(' | '), summaries: r.summaries.join(' | ') }\n}));"
      },
